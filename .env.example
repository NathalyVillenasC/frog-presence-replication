# Dataset locations. Copy this file to .env and replace the paths with wherever the
# three collections live on your machine:
#
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
#
# The audio is not stored in this repository and never should be: the three collections
# together weigh about 35 GB. Only the paths below are configuration.
#
# The name of each top-level folder does not matter — point these variables at whatever
# you called yours. What must be preserved is the structure *inside* each folder, which
# is how the collections arrive and which the notebook relies on. Paths may contain
# spaces and are written without quotes.

# Dataset 1 — labelled frog calls, published by the authors and downloadable by anyone:
# https://data.mendeley.com/datasets/5j852hzfjs/1
# Point it at a folder that holds only this dataset (the species folders, "segment files"
# and "Unidentified Long Recordings"). The notebooks inventory it recursively, so a folder
# that also contains the other two collections or the processed outputs would be counted
# as Mendeley material.
MENDELEY_CALL_DIR=/path/to/mendeley-labelled-calls-example

# Dataset 2 — pond recordings (P1 and P2) digitised from cassettes. Not publicly
# available: obtained directly from the researchers. One folder per cassette, each with
# an A and a B side inside.
PONDS_CALL_DIR=/path/to/pond-recordings-example

# Dataset 3 — clean species calls. Not publicly available: obtained directly from the
# researchers. One folder per species, two files in each.
SPECIES_CALL_DIR=/path/to/species-calls-example
